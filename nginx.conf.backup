server {
    listen 25666;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    autoindex off;

    location = /index.html { return 301 /; }
    location = /leaderboard.html { return 301 /leaderboard; }
    location = /events.html { return 301 /events; }
    location = /updates.html { return 301 /updates; }
    location = /admin.html { return 301 /mission-control; }

    location = /leaderboard { try_files /leaderboard/index.html /leaderboard.html =404; }
    location = /events { try_files /events/index.html /events.html =404; }
    location = /updates { try_files /updates/index.html /updates.html =404; }
    location = /mission-control { try_files /mission-control/index.html /mission-control.html =404; }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~* \.(env|bak|log|sql|sqlite|sqlite3|db)$ {
        deny all;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
